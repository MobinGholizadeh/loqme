generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT_STAFF
  MERCHANT_OWNER
  ADMIN
}

enum BusinessType {
  BAKERY
  CAFE
  RESTAURANT
  SUPERMARKET
  DELI
  PRODUCE
}

enum VerificationStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum MerchantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
}

enum ListingType {
  SURPRISE_BAG
  FLASH_DEAL
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  SOLD_OUT
  EXPIRED
}

enum SafetyStatus {
  PENDING_REVIEW
  APPROVED
  RESTRICTED
  REJECTED
  UNSAFE
  EXPIRED
}

enum TemperatureRequirement {
  ROOM_TEMP
  CHILLED
  FROZEN
}

enum ReservationStatus {
  PENDING
  CONVERTED_TO_ORDER
  EXPIRED
  RELEASED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REFUNDED
  NO_SHOW
}

enum PaymentGatewayType {
  MOCK
  ZARINPAL
  SAMAN
  SADAD
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum FinancialTransactionType {
  CUSTOMER_PAYMENT
  COMMISSION_EARNED
  MERCHANT_PAYOUT
  CUSTOMER_REFUND
}

enum RefundStatus {
  REQUESTED
  APPROVED
  SETTLED
  REJECTED
}

enum ComplaintCategory {
  EXPIRED_FOOD
  SPOILED_FOOD
  MISMATCHED_DESCRIPTION
  POOR_HYGIENE
  STORE_CLOSED
  MISSING_ITEMS
  OTHER
}

enum ComplaintStatus {
  PENDING
  INVESTIGATING
  RESOLVED_REFUNDED
  RESOLVED_REJECTED
  RESOLVED_WARNING
}

model User {
  id          String          @id @default(uuid())
  mobile      String          @unique
  role        Role            @default(CUSTOMER)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  customer         Customer?
  ownedStores      Merchant[]      @relation("MerchantOwner")
  staffRoles       MerchantStaff[]
  sessions         Session[]
  processedRefunds Refund[]        @relation("RefundProcessor")
  verifiedPickups  PickupVerification[] @relation("VerifiedPickups")
  resolvedComplaints Complaint[]   @relation("ResolvedComplaints")
  auditLogs        AuditLog[]
  merchantApplication MerchantApplication? @relation("ApplicationApplicant")
  reviewedApplications MerchantApplication[] @relation("ApplicationReviewer")

  @@index([mobile])
}

model Customer {
  id                     String        @id @default(uuid())
  userId                 String        @unique
  fullName               String?
  cumulativeSavingsToman BigInt        @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites              Favorite[]
  reservations           Reservation[]
  orders                 Order[]
  reviews                Review[]
  complaints             Complaint[]
}

model Merchant {
  id                 String             @id @default(uuid())
  ownerUserId        String
  businessNameFa     String
  businessType       BusinessType       @default(BAKERY)
  licenseNumber      String?
  verificationStatus VerificationStatus @default(PENDING)
  commissionPercent  Decimal            @default(10.0) @db.Decimal(5, 2)
  ratingAverage      Float              @default(5.0)
  ratingCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner              User               @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  staff              MerchantStaff[]
  locations          MerchantLocation[]
  listings           Listing[]
  favorites          Favorite[]
  orders             Order[]
  reviews            Review[]
  complaints         Complaint[]

  application        MerchantApplication?
  mapirPlaceId       String?            @unique

  @@index([ownerUserId])
}

model MerchantStaff {
  id            String    @id @default(uuid())
  merchantId    String
  userId        String
  role          StaffRole @default(CASHIER)
  canScanPickup Boolean   @default(true)
  createdAt     DateTime  @default(now())

  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedPickups PickupVerification[] @relation("StaffVerifiedPickups")

  @@unique([merchantId, userId])
}

model MerchantApplication {
  id             String @id @default(uuid())
  applicantId    String @unique
  ownerName      String
  businessNameFa String
  businessType   BusinessType
  cityId         String
  addressFa      String
  latitude       Float
  longitude      Float
  phone          String?
  licenseNumber  String?
  mapirPlaceId   String?
  hours          Json
  status         MerchantApplicationStatus @default(PENDING)
  revision       Int @default(1)
  reviewReason   String?
  reviewedById   String?
  reviewedAt     DateTime?
  merchantId     String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applicant User @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([mapirPlaceId])
}

model Province {
  id        String   @id @default(uuid())
  nameFa    String
  slug      String   @unique
  cities    City[]
  createdAt DateTime @default(now())
}

model City {
  id                String             @id @default(uuid())
  provinceId        String
  nameFa            String
  slug              String
  createdAt         DateTime           @default(now())

  province          Province           @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  neighborhoods     Neighborhood[]
  merchantLocations MerchantLocation[]

  applications      MerchantApplication[]

  @@unique([provinceId, slug])
}

model Neighborhood {
  id                String             @id @default(uuid())
  cityId            String
  nameFa            String
  slug              String
  centerLat         Float
  centerLng         Float
  createdAt         DateTime           @default(now())

  city              City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  merchantLocations MerchantLocation[]

  @@unique([cityId, slug])
}

model MerchantLocation {
  id             String                                 @id @default(uuid())
  merchantId     String
  cityId         String
  neighborhoodId String?
  addressFa      String
  postalCode     String?
  latitude       Float
  longitude      Float
  phone          String?
  geom           Unsupported("geography(Point, 4326)")?
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt

  merchant       Merchant                               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  city           City                                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  neighborhood   Neighborhood?                          @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  hours          MerchantHours[]
  listings       Listing[]

  @@index([merchantId])
  @@index([cityId])
  @@index([neighborhoodId])
}

model MerchantHours {
  id                 String           @id @default(uuid())
  merchantLocationId String
  dayOfWeek          Int              // 0 = Saturday, 1 = Sunday, ..., 6 = Friday
  isOpen             Boolean          @default(true)
  storeOpenTime      String           // e.g. "08:00"
  storeCloseTime     String           // e.g. "22:00"
  defaultPickupStart String?          // Unset until the merchant configures pickup
  defaultPickupEnd   String?

  location           MerchantLocation @relation(fields: [merchantLocationId], references: [id], onDelete: Cascade)

  @@unique([merchantLocationId, dayOfWeek])
}

model Category {
  id        String     @id @default(uuid())
  slug      String     @unique
  nameFa    String
  iconUrl   String?
  parentId  String?
  createdAt DateTime   @default(now())

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  listings  Listing[]
}

model Listing {
  id                   String              @id @default(uuid())
  merchantId           String
  merchantLocationId   String?
  categoryId           String
  type                 ListingType         @default(SURPRISE_BAG)
  titleFa              String
  descriptionFa        String?
  originalPriceToman   BigInt
  discountedPriceToman BigInt
  pickupDate           DateTime
  pickupStart          DateTime
  pickupEnd            DateTime
  status               ListingStatus       @default(DRAFT)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  merchant             Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  location             MerchantLocation?   @relation(fields: [merchantLocationId], references: [id], onDelete: SetNull)
  category             Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images               ListingImage[]
  inventory            ListingInventory?
  safety               ListingSafety?
  attributes           ListingAttributes[]
  reservations         Reservation[]
  orderItems           OrderItem[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([status])
  @@index([pickupDate])
  @@index([pickupEnd])
}

model ListingImage {
  id           String   @id @default(uuid())
  listingId    String
  imageUrl     String
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model ListingInventory {
  id               String   @id @default(uuid())
  listingId        String   @unique
  totalQuantity    Int
  reservedQuantity Int      @default(0)
  soldQuantity     Int      @default(0)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ListingSafety {
  id                     String                 @id @default(uuid())
  listingId              String                 @unique
  safetyStatus           SafetyStatus           @default(APPROVED)
  allergens              String[]
  dietaryTags            String[]
  storageInstructionsFa String?
  temperatureRequirement TemperatureRequirement @default(ROOM_TEMP)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  listing                Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ListingAttributes {
  id        String   @id @default(uuid())
  listingId String
  key       String
  valueJson Json

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OtpCode {
  id        String   @id @default(uuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile])
  @@index([expiresAt])
}

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  merchantId String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([customerId, merchantId])
  @@index([customerId])
  @@index([merchantId])
}

model Reservation {
  id         String            @id @default(uuid())
  listingId  String
  customerId String
  quantity   Int               @default(1)
  expiresAt  DateTime
  status     ReservationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  listing    Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?

  @@index([listingId])
  @@index([customerId])
  @@index([expiresAt])
  @@index([status])
}

model Order {
  id                        String                 @id @default(uuid())
  orderNumber               String                 @unique // e.g. "LQ-10492"
  customerId                String
  merchantId                String
  reservationId             String?                @unique
  status                    OrderStatus            @default(PENDING_PAYMENT)
  totalAmountToman          BigInt
  commissionPercent         Decimal                @default(10.0) @db.Decimal(5, 2)
  commissionAmountToman     BigInt                 @default(0)
  merchantPayoutAmountToman BigInt                 @default(0)
  notesFa                   String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  customer                  Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  merchant                  Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reservation               Reservation?           @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  items                     OrderItem[]
  payments                  Payment[]
  financialTransactions     FinancialTransaction[]
  refunds                   Refund[]
  pickupVerification        PickupVerification?
  review                    Review?
  complaints                Complaint[]

  @@index([customerId])
  @@index([merchantId])
  @@index([status])
  @@index([merchantId, status])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  listingId      String
  unitPriceToman BigInt
  quantity       Int      @default(1)
  subtotalToman  BigInt
  createdAt      DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId])
}

model Payment {
  id           String             @id @default(uuid())
  orderId      String
  gateway      PaymentGatewayType @default(MOCK)
  authority    String             @unique // Unique payment gateway reference token
  trackingCode String?
  referenceId  String?
  amountToman  BigInt
  status       PaymentStatus      @default(INITIATED)
  errorMessage String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events       PaymentEvent[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status])
  @@index([authority])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  eventType   String   // e.g. "INITIATED", "CALLBACK_RECEIVED", "VERIFIED", "FAILED"
  payloadJson Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

model FinancialTransaction {
  id              String                   @id @default(uuid())
  orderId         String?
  type            FinancialTransactionType
  debitAccount    String                   // e.g. "CUSTOMER_PAYMENT", "PLATFORM_CASH"
  creditAccount   String                   // e.g. "MERCHANT_PAYABLE", "PLATFORM_COMMISSION"
  amountToman     BigInt
  referenceNumber String?
  createdAt       DateTime                 @default(now())

  order           Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  orderId           String
  amountToman       BigInt
  reasonFa          String
  status            RefundStatus @default(REQUESTED)
  processedByUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  processedBy       User?        @relation("RefundProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)
  complaint         Complaint?

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
}

model PickupVerification {
  id                String         @id @default(uuid())
  orderId           String         @unique
  qrCodeHash        String?
  otpCode           String         // 4-digit numeric code e.g. "8491"
  isVerified        Boolean        @default(false)
  verifiedAt        DateTime?
  verifiedByUserId  String?
  verifiedByStaffId String?
  attemptCount      Int            @default(0)
  lockedUntil       DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedByUser    User?          @relation("VerifiedPickups", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedByStaff   MerchantStaff? @relation("StaffVerifiedPickups", fields: [verifiedByStaffId], references: [id], onDelete: SetNull)

  @@index([otpCode, isVerified])
  @@index([orderId])
  @@index([isVerified])
}

model Review {
  id              String    @id @default(uuid())
  orderId         String    @unique
  customerId      String
  merchantId      String
  overallRating   Int       // 1-5
  qualityRating   Int       // 1-5
  valueRating     Int       // 1-5
  commentFa       String?
  merchantReplyFa String?
  merchantReplyAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([customerId])
  @@index([createdAt])
}

model Complaint {
  id               String            @id @default(uuid())
  orderId          String
  customerId       String
  merchantId       String
  category         ComplaintCategory
  descriptionFa    String
  evidencePhotos   String[]          // URLs / file paths
  status           ComplaintStatus   @default(PENDING)
  adminNotesFa     String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  refundId         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  resolvedByUser   User?             @relation("ResolvedComplaints", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  refund           Refund?           @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "SAFETY_OVERRIDE", "COMPLAINT_RESOLVED", "MERCHANT_RESTRICTED"
  entityType  String   // e.g. "ListingSafety", "Complaint", "Merchant", "Order"
  entityId    String
  actorId     String?
  actorRole   Role?
  detailsJson Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}




