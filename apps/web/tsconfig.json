{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@loqme/types": [
        "../../packages/types/src"
      ],
      "@loqme/validation": [
        "../../packages/validation/src"
      ],
      "@loqme/design-tokens": [
        "../../packages/design-tokens/src"
      ],
      "@loqme/api": [
        "../../packages/api/src"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-stitch/types/**/*.ts",
    ".next-redesign-build/types/**/*.ts",
    ".next-feedback-build/types/**/*.ts",
    ".next-account-build/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-stitch/dev/types/**/*.ts",
    ".next-white-teal-followup/types/**/*.ts",
    ".next-white-teal-followup/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
