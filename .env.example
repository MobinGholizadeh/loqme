# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loqme?schema=public"

# Session & JWT Security Key (Minimum 32 characters)
SESSION_SECRET="loqme-development-session-super-secret-key-change-in-production-32c"

# Runtime Environment
NODE_ENV="development"
PORT=3000

# Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional approved HTTPS origin for externally hosted inventory photos.
# Leave empty for same-origin /uploads assets. Set in apps/web/.env before build.
NEXT_PUBLIC_INVENTORY_IMAGE_ORIGIN=""

# Notification / SMS Provider (console | kavenegar | farazsms)
SMS_PROVIDER="console"

# SMS API Keys (Production Only)
KAVENEGAR_API_KEY=""
FARAZSMS_API_KEY=""
# Absolute persistent directory for public merchant-uploaded food photos.
# LISTING_IMAGE_STORAGE_DIR=/var/lib/loqme/listing-images

# Map.ir Integration
NEXT_PUBLIC_MAP_API_KEY=""
# Server-only Map.ir search/reverse key (enable these services in the provider account).
MAPIR_API_KEY=""
