# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loqme?schema=public"

# Session & JWT Security Key (Minimum 32 characters)
SESSION_SECRET="loqme-development-session-super-secret-key-change-in-production-32c"

# Runtime Environment
NODE_ENV="development"
PORT=3000

# Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification / SMS Provider (console | kavenegar | farazsms)
SMS_PROVIDER="console"

# SMS API Keys (Production Only)
KAVENEGAR_API_KEY=""
FARAZSMS_API_KEY=""
