{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@loqme/types": ["./packages/types/src"],
      "@loqme/validation": ["./packages/validation/src"],
      "@loqme/design-tokens": ["./packages/design-tokens/src"],
      "@loqme/api": ["./packages/api/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
