Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Serve old private order links internally, without redirecting tokens through HTTP.
  RewriteRule ^order/?$ order.html [END]
  # Keep previously issued links and existing health monitors working.
  RewriteRule ^api/store/?$ api/store.php [END,QSA]
  RewriteRule ^api/health/?$ api/health.php [END,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
