{
  "name": "loqme",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "npm run build --workspace=@loqme/web",
    "start": "npm run start --workspace=@loqme/web",
    "lint": "npm run lint --workspace=@loqme/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:doppler": "doppler run -- npm run dev",
    "doppler:setup": "doppler setup --project loqme --config dev",
    "env:pull": "doppler secrets download --no-file --format=env > .env",
    "env:pull:prod": "doppler secrets download --no-file --config prd --format=env > .env.production",
    "env:push": "doppler secrets upload .env --config dev",
    "env:push:prod": "doppler secrets upload .env.production --config prd",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "dotenv": "^16.4.7",
    "effect": "^3.20.0",
    "jose": "^5.9.6",
    "next": "^16.3.5",
    "pg": "^8.13.3",
    "prisma": "^7.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "prisma": { "mysql2": "3.24.5" }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "30.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "5.0.3"
  }
}
