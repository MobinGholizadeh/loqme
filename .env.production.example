# ==============================================================================
# Loqme Production Environment Configuration (Doppler 'prd' config)
# ==============================================================================

# Runtime Environment
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Production Public URL
NEXT_PUBLIC_APP_URL="https://loqme.shop"

# Database Credentials & URL
POSTGRES_USER="loqme_admin"
POSTGRES_PASSWORD="generate_a_very_secure_random_db_password_here_min_32_chars"
POSTGRES_DB="loqme"
DATABASE_URL="postgresql://loqme_admin:generate_a_very_secure_random_db_password_here_min_32_chars@postgres:5432/loqme?schema=public"

# Redis Cache & Sessions
REDIS_URL="redis://redis:6379"

# Session & JWT Key (Must be at least 32 random characters)
SESSION_SECRET="generate_a_secure_session_secret_with_openssl_rand_hex_32"

# Local Persistent Storage directory for uploaded images
LISTING_IMAGE_STORAGE_DIR="/app/.data/listing-images"

# SMS Provider Integration (console | smsir)
SMS_PROVIDER="smsir"
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER="30002108039036"
SMSIR_TEMPLATE_ID=""
SMSIR_CODE_PARAM_NAME="Code"

# Iranian Payment Gateway Integration (Zarinpal)
ZARINPAL_MERCHANT_ID=""

# Map.ir Integration
NEXT_PUBLIC_MAP_API_KEY=""
MAPIR_API_KEY=""

# Container Image Tag
LOQME_IMAGE="ghcr.io/mobingholizadeh/loqme:latest"
